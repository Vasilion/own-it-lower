# Copy to .env.local and fill in. Never commit .env.local.

# --- Options data provider -------------------------------------------------
# Tradier is the current choice: its greeks and implied volatility come from
# ORATS, making it one of the few cheap sources that returns usable per-contract
# IV. The sandbox is free, needs no funding, and serves 15-minute delayed data.
#
#   Sign up: https://developer.tradier.com/user/sign_up
#   Token:   Dashboard -> API Access -> Sandbox Access Token
#
# NOTE: sandbox data is licensed for DEVELOPMENT ONLY. Before showing anything to
# a paying user, confirm delayed-redistribution rights in writing first.
TRADIER_ACCESS_TOKEN=
TRADIER_MODE=sandbox

# Optional: force a provider. Defaults to Tradier when a token is present.
# Yahoo is never selected automatically -- its free options endpoint no longer
# returns usable IV (verified 2026-08-25). See lib/data/providers/yahoo.ts.
# OPTIONS_PROVIDER=tradier

# --- Database --------------------------------------------------------------
# Neon Postgres, pooled connection string (ends in -pooler).
# Create a project at https://console.neon.tech -> Connection Details.
DATABASE_URL=

# --- Rates -----------------------------------------------------------------
# FRED supplies the risk-free rate for Black-Scholes.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
