# Copy to .env.local and fill in. Never commit .env.local.

# --- Options data provider -------------------------------------------------
# DEFAULT IS CBOE AND IT NEEDS NO CONFIGURATION AT ALL.
#
# CBOE publishes the delayed option chains that power their own public site as
# plain JSON -- no account, no API key, no brokerage onboarding. One request
# returns the full chain with bid/ask, IV, open interest and greeks. Delayed data
# is the posture this product ships anyway, so this is not a compromise.
#
# Leave everything in this section blank unless CBOE stops working.
#
# Optional override: "cboe" (default) | "tradier" | "yahoo"
# OPTIONS_PROVIDER=cboe

# Paid fallback if CBOE's public endpoint ever changes. Tradier's IV and greeks
# come from ORATS. Signing up means opening a brokerage account, which is why it
# is the fallback rather than the default.
#   https://developer.tradier.com/user/sign_up  ->  API Access -> Sandbox Token
# TRADIER_ACCESS_TOKEN=
# TRADIER_MODE=sandbox

# Yahoo is never selected automatically: its free options endpoint stopped
# returning usable IV (verified 2026-08-25). See lib/data/providers/yahoo.ts.

# --- Database --------------------------------------------------------------
# Neon Postgres, pooled connection string (ends in -pooler).
# Create a project at https://console.neon.tech -> Connection Details.
DATABASE_URL=

# --- Rates -----------------------------------------------------------------
# FRED supplies the risk-free rate for Black-Scholes.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
